# ========================================================
# CODEARENA - CẤU HÌNH HỆ THỐNG FASTAPI & DATABASE
# ========================================================

# 1. Cấu hình CSDL:
# - Để trống DATABASE_URL khi chạy cục bộ (tự động dùng SQLite codearena.db)
# - Điền DATABASE_URL khi deploy lên Render, Neon.tech, Supabase (PostgreSQL):
DATABASE_URL=postgresql://username:password@hostname:5432/arenacode

# 2. Cấu hình máy chủ FastAPI
API_HOST=0.0.0.0
API_PORT=8000

# 3. Cấu hình Google Gemini AI Auto-Judge (Tùy chọn)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
